{
  "id": "openhouse-crm",
  "name": "Open House CRM",
  "description": "Adds one audited CRM tool with human-reviewed writes.",
  "contracts": {
    "tools": [
      "openhouse_crm"
    ]
  },
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      }
    }
  }
}
