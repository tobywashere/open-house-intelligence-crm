# Open House Intelligence — environment configuration
#
# Copy this file to `.env` (gitignored) and fill in real values as needed.
# scripts/dev.sh and scripts/serve.sh load `.env` automatically. An explicitly
# exported value (for example `AGENT_MODE=mock bash scripts/serve.sh`) wins.
# Every var here is verified against:
#   grep -rhoE 'os\.environ(\.get)?\(["'"'"'][A-Z_]+' backend skills scripts
#   grep -rhoE 'import\.meta\.env\.VITE_[A-Z_]+' dashboard/src
# All defaults below are the literal fallback baked into the code — nothing
# here is a real secret.

# ── Core (backend server) ──────────────────────────────────────────────────

# SQLite file path. Default: backend/data/crm.db (relative to backend/app/).
DB_PATH=

# Agent driver: "mock" (canned/deterministic responses, no LLM) or "openclaw"
# (real gateway-backed agent). Default: mock.
AGENT_MODE=mock

# Interface uvicorn binds to. Default: 127.0.0.1 (localhost only). Set to a
# Tailscale/LAN IP to serve beyond this machine — pair with OHI_API_TOKEN.
HOST=127.0.0.1

# Port used by scripts/serve.sh (and the gb10.sh compatibility shim), which
# defaults to 8080 when this is unset. scripts/dev.sh intentionally uses 8000
# so the Vite development client can use its stable default API URL.
PORT=8080

# Comma-separated list of origins allowed to call the API from a browser
# (CORS). Default: http://localhost:5173,http://localhost:8080 (the Vite dev
# server and the single-port production serve) — deliberately restrictive,
# because localhost binding alone does NOT stop a random web page from
# fetch()-ing this API from the browser you happen to have open; only CORS
# does. Widen only if you know you need to (e.g. a LAN dashboard origin).
CORS_ORIGINS=

# Shared-secret required in the `X-API-Token` header for all /api/* requests
# except /api/health, once HOST is non-localhost. Default: unset (no auth —
# fine for 127.0.0.1-only dev, required once HOST is network-reachable).
OHI_API_TOKEN=

# Name signed at the bottom of AI-drafted intro emails to leads (Gmail via
# Composio, INTEGRATIONS_MODE=live only). Default: unset — drafts go out
# unsigned rather than with a placeholder name.
AGENT_DISPLAY_NAME=

# ── Agent (backend → OpenClaw gateway relay) ────────────────────────────────

# OpenClaw gateway base URL. The production launcher and supported Mac mini
# setup run it on this same machine.
AGENT_GATEWAY_URL=http://localhost:18789

# Bearer token for the gateway, only needed when the gateway's auth mode is
# "token"/"password". Default: unset (gateway auth mode "none").
AGENT_GATEWAY_TOKEN=

# Path appended to AGENT_GATEWAY_URL for chat completions.
# Default: /v1/chat/completions.
AGENT_CHAT_PATH=/v1/chat/completions

# Dedicated OpenClaw agent used by dashboard chat. The setup helper creates it.
# Keep this nonblank so setup, dashboard chat, and Discord target the same agent.
AGENT_ID=openhouse-crm

# Timeout (seconds) for a single agent gateway call. Default: 120.
AGENT_TIMEOUT_SECONDS=120

# Local voice-note transcription command. The application invokes this as the
# OpenClaw CLI executable with `infer audio transcribe --file ... --json`;
# it never passes the value through a shell. Default: openclaw.
VOICE_TRANSCRIBE_COMMAND=openclaw

# Optional explicit OpenClaw audio model selector (`provider/model`). Leave
# blank to use OpenClaw's configured preferred local audio model.
VOICE_TRANSCRIBE_MODEL=

# Timeout for one local voice-note transcription. Default: 120 seconds.
VOICE_TRANSCRIBE_TIMEOUT_SECONDS=120

# Base URL the crm-db-operations skill's tools.py uses to call this backend's
# REST API. Default: http://localhost:8080/api.
CRM_API_URL=http://localhost:8080/api

# Timeout (seconds) for a single crm-db-operations → backend REST call.
# Default: 120.
CRM_API_TIMEOUT_SECONDS=120

# ── Dashboard (Vite build-time, VITE_-prefixed = exposed to the browser) ────

# Backend API base URL the dashboard calls. Default (dev): http://localhost:8000/api;
# default (prod build): /api (same-origin, single-port serve).
VITE_API_URL=

# Value sent as the X-API-Token header on every dashboard API request. Must
# match OHI_API_TOKEN if the backend has one set. Default: unset.
VITE_API_TOKEN=

# ── Vertical (swappable sales-industry pack) ────────────────────────────────

# Which vertical pack to load: <VERTICALS_DIR>/<VERTICAL>/pack.json, merged

# The daily market-research scope (regions/topics/keywords the web search
# looks for) ships in the active pack's `research` block and is editable at
# runtime from the dashboard — no env var. Stored in the `settings` table,
# key `research`; a saved row wins over the pack's defaults.
# over the real-estate built-in defaults (backend/app/vertical.py's
# DEFAULT_PACK — missing/partial/broken packs degrade to those defaults
# rather than failing). Default: real-estate.
VERTICAL=real-estate

# Directory containing <name>/pack.json vertical packs. Default: verticals/
# (relative to the repo root).
VERTICALS_DIR=

# ── Integrations (optional — Gmail/Google Calendar via Composio) ───────────

# "off" (simulated — no real network calls) or "live" (real Composio calls).
# Default: off.
INTEGRATIONS_MODE=off

# "on" opts into the background Gmail poller. Replies from known leads are
# logged automatically. Mail from unknown senders becomes an editable new-lead
# proposal and is not saved until a person approves it. Only takes effect when
# INTEGRATIONS_MODE=live and a Composio key is configured. Default: off because
# enabling it grants the app read access to a personal mailbox.
INTEGRATIONS_POLLER=off

# Composio transport: "api" (hosted Composio backend) or "cli" (local
# `composio` CLI, e.g. on the GB10). Default: api.
COMPOSIO_TRANSPORT=api

# Composio API key. Required for INTEGRATIONS_MODE=live with transport=api.
# Default: unset (no key = integrations effectively off regardless of mode).
COMPOSIO_API_KEY=

# Composio user/account identifier for tool calls. Default: default.
COMPOSIO_USER_ID=default

# Composio hosted API base URL. Default: https://backend.composio.dev.
COMPOSIO_BASE_URL=https://backend.composio.dev

# Timeout (seconds) for a single composio-email-calendar skill CLI call.
# Default: 30.
COMPOSIO_CLI_TIMEOUT_SECONDS=30

# IANA timezone used to interpret/format Google Calendar event times.
# Default: America/Los_Angeles.
GCAL_TIMEZONE=America/Los_Angeles

# ── Knowledge (local BM25 retrieval over docs/knowledge/*.md) ──────────────

# Directory of .md files to chunk/index for POST /chat and
# GET /api/knowledge/search. Relative paths resolve from the repo root. Any
# file dropped here is indexed automatically — this is the per-industry
# swap point (see docs/knowledge/README.md). Default: docs/knowledge.
KNOWLEDGE_DIR=

# Max chunks retrieve() returns per query (also the endpoint's default `k`,
# still bounded 1-10 by the endpoint regardless of this value). Default: 3.
KNOWLEDGE_TOP_K=

# Minimum BM25 score a chunk must clear to be returned — one of TWO gates a
# hit must pass (the other, not configurable, is a discriminative-term
# check: a chunk only counts if it matches at least one query term whose
# corpus IDF is above the corpus's own median — this is what actually
# rejects CRM-chatter queries like "remind me to call my mom", which share
# only corpus-common words like "call"/"open"/"house" with real-estate
# chunks and would otherwise still clear a flat score floor). Raising this
# score floor is NOT the fix for false positives — it's corpus-specific
# tuning that also risks cutting genuine matches; the IDF gate is what
# generalizes across corpora. Default: 1.0, chosen empirically against the
# shipped report: genuine multi-term matches on a real question score well
# above 3, while a fully unrelated query scores 0 — 1.0 sits above float
# noise from an incidental single-term overlap and well below any real hit
# (see backend/tests/test_knowledge.py).
KNOWLEDGE_MIN_SCORE=
