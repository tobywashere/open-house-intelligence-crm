{
  "name": "real-estate",
  "display_name": "Real estate",
  "stages": [
    {
      "key": "new",
      "label": "New leads",
      "rule": {
        "type": "all"
      }
    },
    {
      "key": "contacted",
      "label": "Contacted",
      "rule": {
        "type": "status_at_least",
        "status": "contacted"
      }
    },
    {
      "key": "qualified",
      "label": "Qualified",
      "rule": {
        "type": "status_at_least_or_score",
        "status": "meeting_booked",
        "score_status": "contacted",
        "min_score": 70
      }
    },
    {
      "key": "tours",
      "label": "Tours booked",
      "rule": {
        "type": "status_at_least",
        "status": "meeting_booked"
      }
    },
    {
      "key": "offers",
      "label": "Offers submitted",
      "rule": {
        "type": "event_type_or_status",
        "event_type": "offer",
        "status": "closed"
      }
    },
    {
      "key": "closed",
      "label": "Closed",
      "rule": {
        "type": "status_is",
        "status": "closed"
      }
    }
  ],
  "labels": {
