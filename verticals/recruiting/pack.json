{
  "name": "recruiting",
  "display_name": "Recruiting & staffing",
  "stages": [
    {
      "key": "new",
      "label": "New candidates",
      "rule": {
        "type": "all"
      }
    },
    {
      "key": "contacted",
      "label": "Contacted",
      "rule": {
        "type": "status_at_least",
        "status": "contacted"
      }
    },
    {
      "key": "qualified",
      "label": "Screened",
      "rule": {
        "type": "status_at_least_or_score",
        "status": "meeting_booked",
        "score_status": "contacted",
        "min_score": 70
      }
    },
    {
      "key": "tours",
      "label": "Onsites scheduled",
      "rule": {
        "type": "status_at_least",
        "status": "meeting_booked"
      }
    },
    {
      "key": "offers",
      "label": "Offers extended",
      "rule": {
        "type": "event_type_or_status",
        "event_type": "offer",
        "status": "closed"
      }
    },
    {
      "key": "closed",
      "label": "Placed",
      "rule": {
        "type": "status_is",
        "status": "closed"
      }
    }
  ],
  "labels": {
    "budget": "Comp target",
    "area": "Location",
    "timeline": "Availability",
    "intent": "Role type"
  },
  "intent_values": [
    {
      "value": "buy",
      "label": "Actively looking"
    },
    {
      "value": "sell",
      "label": "Passive"
    },
    {
      "value": "browse",
      "label": "Exploring"
    },
    {
      "value": "unknown",
      "label": "Unknown"
    }
  ],
  "personas": [
    {
      "key": "Senior IC",
      "default": false
    },
    {
      "key": "Engineering Leader",
      "default": false
    },
    {
      "key": "Relocating Candidate",
      "default": false
    },
    {
      "key": "Early Career",
      "default": false
    },
    {
      "key": "Passive Candidate",
      "default": false
    },
    {
      "key": "Candidate",
      "default": true
    }
  ],
  "copy": {
    "booking.booked": "Interview booked",
    "booking.cta": "Book an interview",
    "chat.example_1": "Add Dana Okoro, staff backend engineer, open to Toronto or remote",
    "chat.example_2": "Which candidates are waiting on feedback?",
    "chat.example_3": "Show me everything we know about Dana",
    "lead.subject_with_area": "Roles in {area}",
    "lead.subject_generic": "Following up on your search",
    "inbox.add_placeholder": "New candidate from a note, e.g. \"Met Dana at the meetup, staff backend, wants remote…\"",
    "funnel.stage_negotiating": "In offer negotiation",
    "funnel.action_book_tours_title": "Book more onsites this week",
    "funnel.action_advance_title": "Advance {n} screened candidate{s} to an onsite",
    "funnel.kpi_qualified_buyers": "Screened candidates",
    "funnel.kpi_tours_scheduled": "Onsites scheduled",
    "insights.meeting_verb_phrase": "book an interview",
    "insights.meeting_noun": "interview",
    "insights.tour_noun": "interview",
    "insights.tour_noun_plural": "interviews",
    "insights.demand_actor_plural": "active candidates",
    "funnel.action_book_tours_sub": "Only {n} upcoming — onsites drive offers",
    "export.upcoming_tours_heading": "## Upcoming interviews",
    "export.summary_title": "Candidate summary",
    "note.offer_heading": "Log an offer",
    "note.offer_chip": "💰 Offer",
    "note.offer_saved": "Offer logged — it now counts in the funnel.",
    "note.offer_placeholder": "e.g. \"Offer extended: $210,000 base + equity\"",
    "note.note_placeholder": "e.g. \"Call with Dana — wants scope over title, available in 6 weeks\""
  },
  "brand": {
    "name": "Talent",
    "name_accent": "Intelligence"
  },
  "persona_rules": [
    {
      "persona": "Passive Candidate",
      "when": {
        "field": "intent",
        "op": "eq",
        "value": "sell"
      }
    },
    {
      "persona": "Engineering Leader",
      "when": {
        "field": "budget",
        "op": "gte",
        "value": 300000
      }
    },
    {
      "persona": "Senior IC",
      "when": {
        "any": [
          {
            "field": "preferences_text",
            "op": "regex",
            "value": "staff|principal|architect|distributed systems"
          },
          {
            "field": "name",
            "op": "regex",
            "value": "&| and ",
            "flags": "i"
          }
        ]
      }
    },
    {
      "persona": "Relocating Candidate",
      "when": {
        "any": [
          {
            "field": "preferences_text",
            "op": "regex",
            "value": "relocat|visa|sponsor"
          },
          {
            "field": "timeline",
            "op": "regex",
            "value": "week|asap",
            "flags": "i"
          }
        ]
      }
    },
    {
      "persona": "Early Career",
      "when": {
        "all": [
          {
            "field": "budget",
            "op": "gt",
            "value": 0
          },
          {
            "field": "budget",
            "op": "lt",
            "value": 120000
          }
        ]
      }
    },
    {
      "persona": "Candidate",
      "when": null
    }
  ],
  "persona_recommendations": {
    "Engineering Leader": "Lead with scope and team size, not the tech stack.",
    "Senior IC": "Bring the hardest technical problem on the roadmap.",
    "Relocating Candidate": "Confirm visa and relocation support before the onsite.",
    "Passive Candidate": "Keep it short — one specific reason this role is different."
  },
  "persona_recommendation_default": "Confirm their availability and agree the next concrete step.",
  "schedule_titles": {
    "default": "Interview",
    "sell": "Intro call"
  },
  "mock_summary": {
    "greeting": "Good morning — here is your pipeline at a glance.",
    "market_watch": [
      {
        "title": "Staff-level comp bands widen as employers compete on scope",
        "source": "Example Comp Report",
        "geo": "Toronto",
        "takeaway": "Lead senior conversations with scope and ownership; band midpoints are no longer the differentiator they were."
      },
      {
        "title": "Return-to-office mandates push senior engineers back to market",
        "source": "Example Talent Weekly",
        "geo": "Seattle",
        "takeaway": "Passive outreach is landing better this quarter — a short, specific message about remote flexibility is converting."
      }
    ],
    "ai_insights": [
      {
        "title": "Interviews cluster late in the week",
        "body": "Most scheduled interviews land Thursday–Friday. Offering earlier slots first would shorten time-to-onsite."
      }
    ]
  },
  "research": {
    "role": "a talent-market analyst for a technical recruiting team",
    "audience": "a technical recruiter",
    "regions": [
      "Toronto",
      "Vancouver",
      "Seattle",
      "Bay Area",
      "Remote (North America)"
    ],
    "topics": [
      "Compensation benchmark and equity-refresh trends",
      "Layoffs, hiring freezes, and team expansions at competitor employers",
      "Return-to-office policy changes",
      "Immigration and work-permit policy changes",
      "In-demand skill shifts and emerging role titles",
      "Notice-period and counteroffer norms by market",
      "Contractor versus full-time classification rules",
      "University and bootcamp pipeline changes"
    ],
    "exclusions": [
      "generic career-advice content",
      "national unemployment statistics without sector relevance",
      "opinion pieces without new information",
      "duplicate stories"
    ],
    "national_scope_note": "Do NOT summarize the national labour market unless it changes what candidates in these markets expect on comp, location, or timing.",
    "lookback_days": 7
  }
}
